<?xml version="1.0" encoding="utf-8"?>
<!-- BumBoard Material 3 keys: a soft layered shadow (level-1 elevation) under each key. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><layer-list><item android:top="1dp" android:bottom="0.5dp"><shape android:shape="rectangle"><solid android:color="?attr/bumColorFunctionalPressed" /><corners android:radius="8dp" /></shape></item></layer-list></item>
    <item><layer-list><item android:top="2dp" android:left="0.5dp" android:right="0.5dp"><shape android:shape="rectangle"><solid android:color="@color/bum_m3_shadow_ambient" /><corners android:radius="8dp" /></shape></item><item android:top="1dp" android:bottom="0.5dp" android:left="0.25dp" android:right="0.25dp"><shape android:shape="rectangle"><solid android:color="@color/bum_m3_shadow_soft" /><corners android:radius="8dp" /></shape></item><item android:top="0.5dp" android:bottom="1dp"><shape android:shape="rectangle"><solid android:color="@color/bum_m3_shadow" /><corners android:radius="8dp" /></shape></item><item android:bottom="1.5dp"><shape android:shape="rectangle"><solid android:color="?attr/bumColorFunctional" /><corners android:radius="8dp" /></shape></item></layer-list></item>
</selector>
