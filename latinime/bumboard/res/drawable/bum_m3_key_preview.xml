<?xml version="1.0" encoding="utf-8"?>
<!--
    The bubble above a pressed key. LatinIME sizes the preview, and places long-press popups,
    from this background's size and padding, so they match the Material 2 bubble it replaces
    (keyboard_key_feedback_background_lxx_*): at least 56 x 78 dp, the letter in the top part,
    and the lower 64 dp reaching down over the key itself.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bum_m3_surface_high" />
            <corners android:radius="14dp" />
            <size android:width="56dp" android:height="78dp" />
            <padding
                android:left="4dp"
                android:top="2dp"
                android:right="4dp"
                android:bottom="64dp" />
        </shape>
    </item>
</layer-list>
