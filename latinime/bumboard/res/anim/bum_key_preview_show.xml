<?xml version="1.0" encoding="utf-8"?>
<!-- The key preview pops up at once, as on Gboard (the briefest fade). -->
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <objectAnimator
        android:propertyName="alpha"
        android:duration="30"
        android:valueFrom="0.0"
        android:valueTo="1.0" />
</set>
