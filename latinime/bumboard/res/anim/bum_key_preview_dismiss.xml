<?xml version="1.0" encoding="utf-8"?>
<!-- The key preview shrinks back into the key as it fades. -->
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <objectAnimator
        android:propertyName="scaleX"
        android:duration="70"
        android:valueFrom="1.00"
        android:valueTo="0.85" />
    <objectAnimator
        android:propertyName="scaleY"
        android:duration="70"
        android:valueFrom="1.00"
        android:valueTo="0.8" />
    <objectAnimator
        android:propertyName="alpha"
        android:duration="70"
        android:valueFrom="1.0"
        android:valueTo="0.0" />
</set>
