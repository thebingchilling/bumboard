<?xml version="1.0" encoding="utf-8"?>
<!--
    BumBoard's Material 3 keyboard theme, built on LatinIME's LXX layout and metrics. It follows
    the system light/dark mode and, on Android 12+, the wallpaper colours (bumboard_m3_colors).
    Two variants differ only in key shape: flat keys and raised keys with a shadow; the views'
    styles pick the key drawables through the theme attributes bumKeyBackground and
    bumFunctionalKeyBackground. Icons are tinted at draw time (KeyboardView, bumIconColor etc.).
-->
<resources>
    <!--
        Colour styles, applied over the keyboard theme (KeyboardSwitcher, BumColorStyle):
        neutral grey functional keys like Gboard's (the default), or keys tinted from the wallpaper.
    -->
    <style name="BumColors.Neutral" parent="">
        <item name="bumColorFunctional">@color/bum_m3_key_functional_neutral</item>
        <item name="bumColorFunctionalPressed">@color/bum_m3_key_functional_pressed_neutral</item>
        <item name="bumColorOnFunctional">@color/bum_m3_on_key_functional_neutral</item>
    </style>
    <style name="BumColors.Wallpaper" parent="">
        <item name="bumColorFunctional">@color/bum_m3_key_functional</item>
        <item name="bumColorFunctionalPressed">@color/bum_m3_key_functional_pressed</item>
        <item name="bumColorOnFunctional">@color/bum_m3_on_key_functional</item>
    </style>

    <style name="KeyboardIcons.BumM3" parent="KeyboardIcons.LXX_Light">
        <item name="iconShiftKey">@drawable/ic_sym_shift</item>
        <item name="iconShiftKeyShifted">@drawable/ic_sym_shift_filled</item>
        <item name="iconDeleteKey">@drawable/ic_sym_backspace</item>
        <item name="iconLanguageSwitchKey">@drawable/ic_sym_language</item>
        <item name="iconEmojiActionKey">@drawable/ic_sym_mood</item>
        <item name="iconEmojiNormalKey">@drawable/ic_sym_mood</item>
        <item name="iconSettingsKey">@drawable/ic_sym_settings</item>
        <item name="iconShortcutKey">@drawable/ic_sym_mic</item>
        <item name="iconOneHandedKey">@drawable/ic_sym_front_hand</item>
    </style>

    <style name="KeyboardTheme.BumM3" parent="KeyboardIcons.BumM3">
        <item name="inputViewStyle">@style/InputView.LXX</item>
        <item name="keyboardViewStyle">@style/KeyboardView.BumM3</item>
        <item name="mainKeyboardViewStyle">@style/MainKeyboardView.BumM3</item>
        <item name="emojiPalettesViewStyle">@style/MainKeyboardView.BumM3</item>
        <item name="moreKeysKeyboardViewStyle">@style/MoreKeysKeyboardView.BumM3</item>
        <item name="moreKeysKeyboardViewForActionStyle">@style/MoreKeysKeyboardView.BumM3.Action</item>
        <item name="suggestionStripViewStyle">@style/SuggestionStripView.BumM3</item>
        <item name="suggestionWordStyle">@style/SuggestionWord.BumM3</item>
    </style>
    <style name="KeyboardTheme.BumM3.Flat">
        <item name="keyboardStyle">@style/Keyboard.BumM3.Flat</item>
        <item name="moreKeysKeyboardStyle">@style/MoreKeysKeyboard.BumM3.Flat</item>
        <item name="bumKeyBackground">@drawable/bum_m3_key_flat</item>
        <item name="bumFunctionalKeyBackground">@drawable/bum_m3_key_functional_flat</item>
        <item name="bumPillKeyBackground">@drawable/bum_m3_key_pill_flat</item>
    </style>
    <style name="KeyboardTheme.BumM3.Raised">
        <item name="keyboardStyle">@style/Keyboard.BumM3.Raised</item>
        <item name="moreKeysKeyboardStyle">@style/MoreKeysKeyboard.BumM3.Raised</item>
        <item name="bumKeyBackground">@drawable/bum_m3_key_raised</item>
        <item name="bumFunctionalKeyBackground">@drawable/bum_m3_key_functional_raised</item>
        <item name="bumPillKeyBackground">@drawable/bum_m3_key_pill_raised</item>
    </style>

    <!-- themeId must match KeyboardTheme.THEME_ID_BUM_* -->
    <style name="Keyboard.BumM3.Flat" parent="Keyboard">
        <item name="themeId">BumFlat</item>
        <!-- Gboard's measurements (from a 1080px-wide phone): rows 3.5% apart, a margin of 2.2% above
             the keys and 4% below, keys 1.6% apart with 0.6% more at the sides -->
        <item name="keyboardTopPadding">2.2%p</item>
        <item name="keyboardBottomPadding">4%p</item>
        <item name="verticalGap">3.5%p</item>
        <item name="horizontalGap">1.6%p</item>
        <item name="keyboardLeftPadding">0.6%p</item>
        <item name="keyboardRightPadding">0.6%p</item>
    </style>
    <style name="Keyboard.BumM3.Raised" parent="Keyboard">
        <item name="themeId">BumRaised</item>
        <!-- Gboard's measurements (from a 1080px-wide phone): rows 3.5% apart, a margin of 2.2% above
             the keys and 4% below, keys 1.6% apart with 0.6% more at the sides -->
        <item name="keyboardTopPadding">2.2%p</item>
        <item name="keyboardBottomPadding">4%p</item>
        <item name="verticalGap">3.5%p</item>
        <item name="horizontalGap">1.6%p</item>
        <item name="keyboardLeftPadding">0.6%p</item>
        <item name="keyboardRightPadding">0.6%p</item>
    </style>

    <style name="KeyboardView.BumM3" parent="KeyboardView.LXX">
        <item name="android:background">@color/bum_m3_kb_background</item>
        <item name="keyBackground">?attr/bumKeyBackground</item>
        <item name="functionalKeyBackground">?attr/bumFunctionalKeyBackground</item>
        <item name="spacebarBackground">?attr/bumKeyBackground</item>
        <item name="keyTextColor">@color/bum_m3_on_key</item>
        <item name="keyTextInactivatedColor">@color/bum_m3_on_key_variant</item>
        <item name="functionalTextColor">?attr/bumColorOnFunctional</item>
        <item name="keyHintLetterColor">@color/bum_m3_on_key_variant</item>
        <item name="keyHintLabelColor">@color/bum_m3_on_key_variant</item>
        <item name="keyShiftedLetterHintInactivatedColor">@color/bum_m3_on_key_variant</item>
        <item name="keyShiftedLetterHintActivatedColor">@color/bum_m3_on_key</item>
        <item name="keyPreviewTextColor">@color/bum_m3_on_key</item>
        <item name="keyPreviewTextRatio">52%</item>
        <item name="bumIconColor">@color/bum_m3_on_key</item>
        <item name="bumFunctionalIconColor">?attr/bumColorOnFunctional</item>
        <item name="bumActionColor">@color/bum_m3_on_primary</item>
        <item name="bumStickyOnColor">@color/bum_m3_on_primary_container</item>
    </style>
    <style name="MainKeyboardView.BumM3" parent="KeyboardView.BumM3">
        <item name="moreKeysKeyboardForActionLayout">@layout/more_keys_keyboard_for_action_lxx</item>
        <item name="keyPreviewBackground">@drawable/bum_m3_key_preview</item>
        <item name="keyPreviewHeight">@dimen/bum_key_preview_height</item>
        <item name="keyPreviewOffset">@dimen/bum_key_preview_offset</item>
        <item name="keyPreviewShowUpAnimator">@anim/bum_key_preview_show</item>
        <item name="keyPreviewDismissAnimator">@anim/bum_key_preview_dismiss</item>
        <item name="gestureFloatingPreviewTextColor">@color/bum_m3_on_key</item>
        <item name="gestureFloatingPreviewColor">@color/bum_m3_surface_high</item>
        <item name="gestureTrailColor">@color/bum_m3_primary</item>
        <item name="slidingKeyInputPreviewColor">@color/bum_m3_sliding_preview</item>
        <item name="languageOnSpacebarTextColor">@color/bum_m3_on_key</item>
        <item name="languageOnSpacebarTextShadowRadius">-1.0</item>
        <!-- the language name stays fully dark, like Gboard's -->
        <item name="languageOnSpacebarFinalAlpha">255</item>
    </style>

    <style name="MoreKeysKeyboard.BumM3.Flat" parent="Keyboard.BumM3.Flat">
        <item name="keyboardTopPadding">0%p</item>
        <item name="keyboardBottomPadding">0%p</item>
        <item name="horizontalGap">0%p</item>
        <item name="keyboardLeftPadding">0%p</item>
        <item name="keyboardRightPadding">0%p</item>
        <item name="touchPositionCorrectionData">@null</item>
    </style>
    <style name="MoreKeysKeyboard.BumM3.Raised" parent="Keyboard.BumM3.Raised">
        <item name="keyboardTopPadding">0%p</item>
        <item name="keyboardBottomPadding">0%p</item>
        <item name="horizontalGap">0%p</item>
        <item name="keyboardLeftPadding">0%p</item>
        <item name="keyboardRightPadding">0%p</item>
        <item name="touchPositionCorrectionData">@null</item>
    </style>
    <style name="MoreKeysKeyboardView.BumM3" parent="KeyboardView.BumM3">
        <item name="android:background">@drawable/bum_m3_popup_panel</item>
        <item name="keyBackground">@drawable/bum_m3_key_popup</item>
        <item name="functionalKeyBackground">@drawable/bum_m3_key_popup</item>
        <item name="divider">@null</item>
        <item name="keyTypeface">normal</item>
        <!-- round keys: the selected one is a filled circle with its symbol in white -->
        <item name="keyLabelFlags">keepBackgroundAspectRatio</item>
        <item name="bumPressedTextColor">@color/bum_m3_on_primary</item>
        <item name="verticalCorrection">@dimen/config_more_keys_keyboard_vertical_correction_holo</item>
        <!-- popup keys have no functional fill, so their icons use the plain key colour -->
        <item name="bumFunctionalIconColor">@color/bum_m3_on_key</item>
    </style>
    <style name="MoreKeysKeyboardView.BumM3.Action">
        <item name="android:background">@android:color/transparent</item>
        <item name="keyBackground">@drawable/bum_m3_key_popup_action</item>
        <item name="functionalKeyBackground">@drawable/bum_m3_key_popup_action</item>
        <item name="keyLabelFlags">keepBackgroundAspectRatio</item>
        <item name="keyTextColor">@color/bum_m3_on_primary</item>
        <item name="functionalTextColor">@color/bum_m3_on_primary</item>
        <item name="bumIconColor">@color/bum_m3_on_primary</item>
        <item name="bumFunctionalIconColor">@color/bum_m3_on_primary</item>
    </style>

    <style name="SuggestionStripView.BumM3" parent="KeyboardView.BumM3">
        <item name="suggestionsCountInStrip">@integer/config_suggestions_count_in_strip</item>
        <item name="centerSuggestionPercentile">@fraction/config_center_suggestion_percentile</item>
        <item name="maxMoreSuggestionsRow">@integer/config_max_more_suggestions_row</item>
        <item name="minMoreSuggestionsWidth">@fraction/config_min_more_suggestions_width</item>
        <item name="android:background">@color/bum_m3_kb_background</item>
        <item name="android:src">@drawable/bum_m3_strip_divider</item>
        <item name="suggestionStripOptions">autoCorrectBold|validTypedWordBold</item>
        <item name="colorValidTypedWord">@color/bum_m3_on_key</item>
        <item name="colorTypedWord">@color/bum_m3_on_key</item>
        <!-- like Gboard's: plain dark words; the autocorrection is shown in bold -->
        <item name="colorAutoCorrect">@color/bum_m3_on_key</item>
        <item name="colorSuggested">@color/bum_m3_on_key</item>
        <item name="alphaObsoleted">70%</item>
    </style>
    <style name="SuggestionWord.BumM3" parent="SuggestionWord">
        <item name="android:background">@drawable/bum_m3_suggestion</item>
        <item name="android:textColor">@color/bum_m3_on_key</item>
    </style>
</resources>
