<!-- BUMBOARD: Gboard's third row of symbols: * " ' : ; ! ? (each with a full popup) -->
<merge
    xmlns:latin="http://schemas.android.com/apk/res-auto"
>
    <switch>
        <!-- Chinese and Japanese (like Gboard's): 、 and curly quotes in place of * " ' -->
        <case
            latin:languageCode="zh|ja"
        >
            <Key
                latin:keySpec="、"
                latin:moreKeys="*,・,､" />
            <Key
                latin:keySpec="“"
                latin:moreKeys="&quot;,「,『,„,«" />
            <Key
                latin:keySpec="”"
                latin:moreKeys="\',」,』,»" />
        </case>
        <case
            latin:languageCode="fa"
        >
            <Key
                latin:keySpec="*"
                latin:moreKeys="!text/morekeys_star" />
            <Key
                latin:keySpec="!text/keyspec_left_double_angle_quote"
                latin:moreKeys="!text/morekeys_double_quote" />
            <Key
                latin:keySpec="!text/keyspec_right_double_angle_quote"
                latin:moreKeys="!text/morekeys_single_quote" />
        </case>
        <default>
            <Key
                latin:keySpec="*"
                latin:moreKeys="!text/morekeys_star" />
            <Key
                latin:keySpec="&quot;"
                latin:moreKeys="“,”,„,«,»" />
            <Key
                latin:keySpec="\'"
                latin:moreKeys="‘,’,‚,‹,›,`,´" />
        </default>
    </switch>
    <Key
        latin:keySpec=":"
        latin:moreKeys="∶,：,⁝" />
    <Key
        latin:keySpec="!text/keyspec_symbols_semicolon"
        latin:moreKeys="⁏,；" />
    <Key
        latin:keySpec="!"
        latin:moreKeys="¡,‼,⁉,！" />
    <Key
        latin:keySpec="!text/keyspec_symbols_question"
        latin:moreKeys="¿,‽,⁇,？" />
</merge>
