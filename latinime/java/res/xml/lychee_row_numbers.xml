<?xml version="1.0" encoding="utf-8"?>
<!-- LYCHEE: the number row above the letters, when it is switched on; popups as Gboard's. -->
<merge
    xmlns:latin="http://schemas.android.com/apk/res-auto"
>
    <switch>
        <case
            latin:lycheeNumberRow="true"
        >
            <Row
                latin:keyWidth="10%p"
            >
                <Key latin:keySpec="1" latin:moreKeys="1,½,⅓,¼,⅕,⅐,⅛,⅑,⅒" />
                <Key latin:keySpec="2" latin:moreKeys="2,⅔,⅖" />
                <Key latin:keySpec="3" latin:moreKeys="3,¾,⅜,⅗" />
                <Key latin:keySpec="4" latin:moreKeys="4,⅘" />
                <Key latin:keySpec="5" latin:moreKeys="5,⅝,⅚" />
                <Key latin:keySpec="6" />
                <Key latin:keySpec="7" latin:moreKeys="7,⅞" />
                <Key latin:keySpec="8" />
                <Key latin:keySpec="9" />
                <Key latin:keySpec="0" latin:moreKeys="0,ⁿ,∅" />
            </Row>
        </case>
    </switch>
</merge>
