<merge
    xmlns:latin="http://schemas.android.com/apk/res-auto"
>
    <!-- BUMBOARD: 2-set (두벌식) Korean; shift (not the automatic one) gives the
         double consonants and ㅒ ㅖ, which are also in each key's long-press. -->
    <switch>
        <case
            latin:keyboardLayoutSetElement="alphabetManualShifted|alphabetShiftLocked|alphabetShiftLockShifted"
        >
            <Key
                latin:keySpec="ㅃ"
                latin:keyHintLabel="1"
                latin:additionalMoreKeys="1" />
            <Key
                latin:keySpec="ㅉ"
                latin:keyHintLabel="2"
                latin:additionalMoreKeys="2" />
            <Key
                latin:keySpec="ㄸ"
                latin:keyHintLabel="3"
                latin:additionalMoreKeys="3" />
            <Key
                latin:keySpec="ㄲ"
                latin:keyHintLabel="4"
                latin:additionalMoreKeys="4" />
            <Key
                latin:keySpec="ㅆ"
                latin:keyHintLabel="5"
                latin:additionalMoreKeys="5" />
            <Key
                latin:keySpec="ㅛ"
                latin:keyHintLabel="6"
                latin:additionalMoreKeys="6" />
            <Key
                latin:keySpec="ㅕ"
                latin:keyHintLabel="7"
                latin:additionalMoreKeys="7" />
            <Key
                latin:keySpec="ㅑ"
                latin:keyHintLabel="8"
                latin:additionalMoreKeys="8" />
            <Key
                latin:keySpec="ㅒ"
                latin:keyHintLabel="9"
                latin:additionalMoreKeys="9" />
            <Key
                latin:keySpec="ㅖ"
                latin:keyHintLabel="0"
                latin:additionalMoreKeys="0" />
        </case>
        <default>
            <Key
                latin:keySpec="ㅂ"
                latin:keyHintLabel="1"
                latin:additionalMoreKeys="1"
                latin:moreKeys="ㅃ" />
            <Key
                latin:keySpec="ㅈ"
                latin:keyHintLabel="2"
                latin:additionalMoreKeys="2"
                latin:moreKeys="ㅉ" />
            <Key
                latin:keySpec="ㄷ"
                latin:keyHintLabel="3"
                latin:additionalMoreKeys="3"
                latin:moreKeys="ㄸ" />
            <Key
                latin:keySpec="ㄱ"
                latin:keyHintLabel="4"
                latin:additionalMoreKeys="4"
                latin:moreKeys="ㄲ" />
            <Key
                latin:keySpec="ㅅ"
                latin:keyHintLabel="5"
                latin:additionalMoreKeys="5"
                latin:moreKeys="ㅆ" />
            <Key
                latin:keySpec="ㅛ"
                latin:keyHintLabel="6"
                latin:additionalMoreKeys="6" />
            <Key
                latin:keySpec="ㅕ"
                latin:keyHintLabel="7"
                latin:additionalMoreKeys="7" />
            <Key
                latin:keySpec="ㅑ"
                latin:keyHintLabel="8"
                latin:additionalMoreKeys="8" />
            <Key
                latin:keySpec="ㅐ"
                latin:keyHintLabel="9"
                latin:additionalMoreKeys="9"
                latin:moreKeys="ㅒ" />
            <Key
                latin:keySpec="ㅔ"
                latin:keyHintLabel="0"
                latin:additionalMoreKeys="0"
                latin:moreKeys="ㅖ" />
        </default>
    </switch>
</merge>
