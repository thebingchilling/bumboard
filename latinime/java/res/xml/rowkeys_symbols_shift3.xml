<!-- LYCHEE: Gboard's second symbols page, third row (‘ ’ on the Chinese keyboards), with its popups -->
<merge
    xmlns:latin="http://schemas.android.com/apk/res-auto"
>
    <Key
        latin:keySpec="%"
        latin:moreKeys="‰" />
    <switch>
        <case
            latin:languageCode="zh|ja"
        >
            <Key
                latin:keySpec="‘"
                latin:moreKeys="\',〈" />
            <Key
                latin:keySpec="’"
                latin:moreKeys="‚,〉" />
        </case>
        <default>
            <Key
                latin:keySpec="©" />
            <Key
                latin:keySpec="®" />
        </default>
    </switch>
    <Key
        latin:keySpec="™" />
    <Key
        latin:keySpec="✓" />
    <Key
        latin:keySpec="[" />
    <Key
        latin:keySpec="]" />
</merge>
