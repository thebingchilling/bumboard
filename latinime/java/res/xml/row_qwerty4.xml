<merge
    xmlns:latin="http://schemas.android.com/apk/res-auto"
>
    <Row
        latin:keyWidth="10%p"
    >
        <Key
            latin:keyStyle="toSymbolKeyStyle"
            latin:keyWidth="15%p" />
        <!-- LYCHEE: emoji, next language or no key beside the comma (Settings >
             Preferences); without one the space bar takes its room. -->
        <switch>
            <case
                latin:lycheeSideKey="false"
            >
                <include
                    latin:keyboardLayout="@xml/key_comma" />
                <Key
                    latin:keyStyle="spaceKeyStyle"
                    latin:keyWidth="50%p" />
            </case>
            <case
                latin:lycheeEmojiKey="true"
            >
                <Key
                    latin:keyStyle="emojiKeyStyle"
                    latin:backgroundType="functional" />
                <include
                    latin:keyboardLayout="@xml/key_comma" />
                <Key
                    latin:keyStyle="spaceKeyStyle"
                    latin:keyWidth="40%p" />
            </case>
            <default>
                <Key
                    latin:keyStyle="languageSwitchKeyStyle"
                    latin:backgroundType="functional" />
                <include
                    latin:keyboardLayout="@xml/key_comma" />
                <Key
                    latin:keyStyle="spaceKeyStyle"
                    latin:keyWidth="40%p" />
            </default>
        </switch>
        <include
            latin:keyboardLayout="@xml/key_period" />
        <Key
            latin:keyStyle="enterKeyStyle"
            latin:keyWidth="fillRight" />
    </Row>
</merge>
