<!-- BUMBOARD: Gboard's second symbols page, first row: ~ ` | • √ π ÷ × § Δ -->
<merge
    xmlns:latin="http://schemas.android.com/apk/res-auto"
>
    <Key
        latin:keySpec="~"
        latin:moreKeys="≈,∼,～,≃" />
    <Key
        latin:keySpec="`"
        latin:moreKeys="´,ˋ,ˊ" />
    <Key
        latin:keySpec="|"
        latin:moreKeys="¦,‖,∣" />
    <Key
        latin:keySpec="•"
        latin:moreKeys="·,◦,‣,○,●,■,□" />
    <Key
        latin:keySpec="&#x221A;"
        latin:moreKeys="∛,∜,∞" />
    <Key
        latin:keySpec="&#x03C0;"
        latin:moreKeys="Π,τ,φ,θ,µ,Ω" />
    <Key
        latin:keySpec="÷"
        latin:moreKeys="/,⁄,∕" />
    <Key
        latin:keySpec="&#x00D7;"
        latin:moreKeys="⋅,✕,∗" />
    <Key
        latin:keySpec="§"
        latin:moreKeys="¶,†,‡" />
    <switch>
        <case
            latin:languageCode="zh|ja"
        >
            <Key
                latin:keySpec="*"
                latin:moreKeys="Δ,∂,∑,∏,∫,★,†" />
        </case>
        <default>
            <Key
                latin:keySpec="Δ"
                latin:moreKeys="∆,∂,∑,∏,∫" />
        </default>
    </switch>
</merge>
