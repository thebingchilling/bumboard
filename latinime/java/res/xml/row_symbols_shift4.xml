<merge xmlns:latin="http://schemas.android.com/apk/res-auto" >
    <!-- LYCHEE: (second symbols page) the same bottom row as the letters (row_qwerty4), so nothing moves when
         switching to symbols: the number pad key ("1234", as on Gboard's symbols page) takes
         the emoji/language key's place, and the space and "." keep theirs. "/" and "_" are in
         popups ("." and "-"). -->
    <switch>
        <case
            latin:lycheeSideKey="false"
        >
            <switch>
                <case
                    latin:languageCode="zh|ja"
                >
                    <Key
                        latin:keySpec="&lt;"
                        latin:moreKeys="〈,«,⟨,‹,《,≤"
                        latin:backgroundType="functional" />
                </case>
                <default>
                    <Key
                        latin:keySpec="&lt;"
                        latin:moreKeys="«,≤,‹,⟨"
                        latin:backgroundType="functional" />
                </default>
            </switch>
            <Key
                latin:keyStyle="lycheeNumpadKeyStyle" />
            <Key
                latin:keyStyle="spaceKeyStyle"
                latin:keyWidth="40%p" />
        </case>
        <default>
            <Key
                latin:keyStyle="lycheeNumpadKeyStyle" />
            <switch>
                <case
                    latin:languageCode="zh|ja"
                >
                    <Key
                        latin:keySpec="&lt;"
                        latin:moreKeys="〈,«,⟨,‹,《,≤"
                        latin:backgroundType="functional" />
                </case>
                <default>
                    <Key
                        latin:keySpec="&lt;"
                        latin:moreKeys="«,≤,‹,⟨"
                        latin:backgroundType="functional" />
                </default>
            </switch>
            <Key
                latin:keyStyle="spaceKeyStyle"
                latin:keyWidth="40%p" />
        </default>
    </switch>
        <switch>
        <case
            latin:languageCode="zh|ja"
        >
            <Key
                latin:keySpec="&gt;"
                latin:moreKeys="〉,»,⟩,›,》,≥"
                latin:backgroundType="functional" />
        </case>
        <default>
            <Key
                latin:keySpec="&gt;"
                latin:moreKeys="⟩,»,≥,›"
                latin:backgroundType="functional" />
        </default>
    </switch>
</merge>
