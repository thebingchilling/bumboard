<!-- BUMBOARD: Gboard's second row of symbols: @ # £ _ &amp; - + ( ) / (each with a full popup) -->
<merge
    xmlns:latin="http://schemas.android.com/apk/res-auto"
>
    <switch>
        <case
            latin:languageCode="fa"
        >
            <Key
                latin:keySpec="&#x066C;"
                latin:keyHintLabel="\@"
                latin:moreKeys="\@" />
            <Key
                latin:keySpec="&#x066B;"
                latin:keyHintLabel="\#"
                latin:moreKeys="\#" />
        </case>
        <default>
            <Key
                latin:keySpec="\@"
                latin:moreKeys="＠,ⓐ,©,®" />
            <Key
                latin:keySpec="\#"
                latin:moreKeys="№,＃,♯" />
        </default>
    </switch>
    <Key
        latin:keyStyle="currencyKeyStyle"
        latin:keyLabelFlags="followKeyLetterRatio" />
    <Key
        latin:keySpec="_"
        latin:moreKeys="‗,￣,＿" />
    <Key
        latin:keySpec="&amp;"
        latin:moreKeys="§,¶,＆,⅋" />
    <Key
        latin:keySpec="-"
        latin:moreKeys="–,—,·,‐,−" />
    <Key
        latin:keySpec="+"
        latin:moreKeys="±,∓,＋" />
    <include
        latin:keyboardLayout="@xml/keys_parentheses" />
    <Key
        latin:keySpec="/"
        latin:moreKeys="\\,÷,⁄,∕,／" />
</merge>
