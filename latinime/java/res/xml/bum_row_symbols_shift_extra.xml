<?xml version="1.0" encoding="utf-8"?>
<!-- BUMBOARD: with the number row on, an extra row keeps the second symbols page as tall as the letters. -->
<merge
    xmlns:latin="http://schemas.android.com/apk/res-auto"
>
    <switch>
        <case
            latin:bumNumberRow="true"
        >
            <Row
                latin:keyWidth="10%p"
            >
                <Key latin:keySpec="&#x20AC;" />
                <Key latin:keySpec="&#x00A5;" />
                <Key latin:keySpec="&#x00A3;" />
                <Key latin:keySpec="&#x00A2;" />
                <Key latin:keySpec="&#x00B0;" latin:moreKeys="′,″,℃,℉" />
                <Key latin:keySpec="&#x2190;" />
                <Key latin:keySpec="&#x2191;" />
                <Key latin:keySpec="&#x2193;" />
                <Key latin:keySpec="&#x2192;" />
                <Key latin:keySpec="&#x00A9;" latin:moreKeys="℗" />
            </Row>
        </case>
    </switch>
</merge>
