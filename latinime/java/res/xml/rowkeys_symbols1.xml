<!-- BUMBOARD: the digits, with Gboard's popups (fractions on 1-5 and 7, ⁿ ∅ on 0). -->
<merge
    xmlns:latin="http://schemas.android.com/apk/res-auto"
>
    <Key
        latin:keySpec="1"
        latin:moreKeys="1,½,⅓,¼,⅕,⅐,⅛,⅑,⅒" />
    <Key
        latin:keySpec="2"
        latin:moreKeys="2,⅔,⅖" />
    <Key
        latin:keySpec="3"
        latin:moreKeys="3,¾,⅜,⅗" />
    <Key
        latin:keySpec="4"
        latin:moreKeys="4,⅘" />
    <Key
        latin:keySpec="5"
        latin:moreKeys="5,⅝,⅚" />
    <Key
        latin:keySpec="6" />
    <Key
        latin:keySpec="7"
        latin:moreKeys="7,⅞" />
    <Key
        latin:keySpec="8" />
    <Key
        latin:keySpec="9" />
    <Key
        latin:keySpec="0"
        latin:moreKeys="0,ⁿ,∅" />
</merge>
