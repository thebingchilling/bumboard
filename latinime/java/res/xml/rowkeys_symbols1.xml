<!-- LYCHEE: the digits, each with its superscript and fractions in its popup. -->
<merge
    xmlns:latin="http://schemas.android.com/apk/res-auto"
>
    <Key
        latin:keySpec="1"
        latin:moreKeys="¹,½,⅓,¼,⅕,⅐,⅛,⅑,⅒" />
    <Key
        latin:keySpec="2"
        latin:moreKeys="²,⅔,⅖" />
    <Key
        latin:keySpec="3"
        latin:moreKeys="³,¾,⅜,⅗" />
    <Key
        latin:keySpec="4"
        latin:moreKeys="⁴,⅘" />
    <Key
        latin:keySpec="5"
        latin:moreKeys="⁵,⅝,⅚" />
    <Key
        latin:keySpec="6"
        latin:moreKeys="⁶,⅙" />
    <Key
        latin:keySpec="7"
        latin:moreKeys="⁷,⅞" />
    <Key
        latin:keySpec="8"
        latin:moreKeys="⁸,∞" />
    <Key
        latin:keySpec="9"
        latin:moreKeys="⁹" />
    <Key
        latin:keySpec="0"
        latin:moreKeys="⁰,ⁿ,∅" />
</merge>
