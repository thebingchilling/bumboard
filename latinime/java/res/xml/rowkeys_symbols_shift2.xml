<!-- BUMBOARD: Gboard's second symbols page, second row: € ¥ $ ¢ ^ ° = { } \ -->
<merge
    xmlns:latin="http://schemas.android.com/apk/res-auto"
>
    <Key
        latin:keyStyle="moreCurrency1KeyStyle" />
    <Key
        latin:keyStyle="moreCurrency2KeyStyle" />
    <Key
        latin:keyStyle="moreCurrency3KeyStyle" />
    <Key
        latin:keyStyle="moreCurrency4KeyStyle" />
    <Key
        latin:keySpec="^"
        latin:moreKeys="&#x2191;,&#x2193;,&#x2190;,&#x2192;,ˆ" />
    <Key
        latin:keySpec="&#x00B0;"
        latin:moreKeys="&#x2032;,&#x2033;,℃,℉" />
    <Key
        latin:keySpec="="
        latin:moreKeys="&#x2260;,&#x2248;,&#x221E;,≡,≤,≥" />
    <switch>
        <case
            latin:languageCode="zh|ja"
        >
            <Key
                latin:keySpec="「"
                latin:moreKeys="『,【,〔,《,〈,{" />
            <Key
                latin:keySpec="」"
                latin:moreKeys="』,】,〕,》,〉,}" />
        </case>
        <default>
            <Key
                latin:keySpec="!text/keyspec_left_curly_bracket"
                latin:moreKeys="〔,【,「,『" />
            <Key
                latin:keySpec="!text/keyspec_right_curly_bracket"
                latin:moreKeys="〕,】,」,』" />
        </default>
    </switch>
    <Key
        latin:keySpec="\\"
        latin:moreKeys="/,|,∖" />
</merge>
