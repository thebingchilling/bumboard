<com.android.inputmethod.latin.InputView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="?attr/inputViewStyle">
    <include
        android:id="@+id/main_keyboard_frame"
        layout="@layout/main_keyboard_frame" />
    <!-- BUMBOARD: BumBoard's emoji panel replaces LatinIME's EmojiPalettesView. -->
    <app.bumboard.emoji.EmojiPanelView
        android:id="@+id/emoji_palettes_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:visibility="gone" />
    <!-- BUMBOARD: panels drawn over the keys (shortcuts, text editing, number pad, resizing,
         Chinese candidates); BumPanels places them on the keyboard view. -->
    <app.bumboard.chinese.CandidatePanelView
        android:id="@+id/bum_candidate_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:visibility="gone" />
    <app.bumboard.toolbar.ShortcutGalleryView
        android:id="@+id/bum_gallery_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:visibility="gone" />
    <app.bumboard.toolbar.TextEditPanelView
        android:id="@+id/bum_text_edit_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:visibility="gone" />
    <!-- BUMBOARD: the Japanese 12-key flick keyboard, over the keys on its keyboard. -->
    <app.bumboard.japanese.FlickKeyboardView
        android:id="@+id/bum_flick_keyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:visibility="gone" />
    <app.bumboard.handwriting.HandwritingPanelView
        android:id="@+id/bum_handwriting_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:visibility="gone" />
    <app.bumboard.toolbar.NumpadPanelView
        android:id="@+id/bum_numpad_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:visibility="gone" />
    <app.bumboard.layout.ResizePanelView
        android:id="@+id/bum_resize_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:visibility="gone" />
    <!-- BUMBOARD: resizing the floating keyboard with handles on it; covers the input view. -->
    <app.bumboard.layout.FloatResizeView
        android:id="@+id/bum_float_resize"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</com.android.inputmethod.latin.InputView>
