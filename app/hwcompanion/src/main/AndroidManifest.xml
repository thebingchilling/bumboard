<?xml version="1.0" encoding="utf-8"?>
<!--
    Lychee's Google handwriting companion, a small app of its own (ML Kit's licence needs that).
    Its screen shows each language's ML Kit handwriting model, downloads or removes it; its icon
    is on the launcher (the alias below) unless hidden from that screen. When Lychee binds
    RecognitionService it says which languages its keyboards use, and only those models are
    fetched by themselves (Lychee's pad uses its own engine until they are in). Lychee opens the screen from Settings > Add-ons. Only apps signed with Lychee's key
    may bind the service (the signature permission, which Lychee declares too, so it holds it
    whichever app is installed first).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ML Kit downloads its handwriting models (only the companion goes online, never Lychee) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <permission
        android:name="app.lychee.permission.HANDWRITING"
        android:protectionLevel="signature" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".SetupActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="app.lychee.hwgoogle.SETUP" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            The launcher icon: off in the manifest and switched on at runtime (Icon.apply) unless
            hidden. Since Android 10 an app that uses permissions and has a launcher entry that is
            on in its manifest gets an "App info" stand-in icon on every launcher (Kvaesitso, Pixel
            Launcher, Nova ...) when that entry is turned off; one that is off in the manifest gets
            none, so hiding really hides it.
        -->
        <activity-alias
            android:name=".Launcher"
            android:targetActivity=".SetupActivity"
            android:exported="true"
            android:enabled="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!--
            ML Kit sends Google performance and usage figures (Google's data transport). Google's
            API terms forbid interfering with that, so it is left as ML Kit ships it, and the
            app's privacy note says so. What is written is never part of it.
        -->
        <service
            android:name=".RecognitionService"
            android:exported="true"
            android:permission="app.lychee.permission.HANDWRITING" />
    </application>
</manifest>
