<?xml version="1.0" encoding="utf-8"?>
<!--
    Lychee's Google handwriting companion. No launcher icon and nothing to open: installed, it
    fetches ML Kit's handwriting models by itself the first time Lychee binds RecognitionService
    (Lychee's pad uses its own engine until they are in). Only apps signed with Lychee's key may
    bind it (the signature permission, which Lychee declares too, so it holds it whichever app is
    installed first). SetupActivity, a small dialog opened from Lychee (Settings > Add-ons >
    Models), shows the download and closes itself; it never stays in recents.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ML Kit downloads its handwriting models (only the companion goes online, never Lychee) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <permission
        android:name="app.lychee.permission.HANDWRITING"
        android:protectionLevel="signature" />

    <application
        android:label="@string/app_name"
        android:allowBackup="false">

        <activity
            android:name=".SetupActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault.Dialog.NoActionBar">
            <intent-filter>
                <action android:name="app.lychee.hwgoogle.SETUP" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".RecognitionService"
            android:exported="true"
            android:permission="app.lychee.permission.HANDWRITING" />
    </application>
</manifest>
