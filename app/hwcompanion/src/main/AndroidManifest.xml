<?xml version="1.0" encoding="utf-8"?>
<!--
    Lychee's Google handwriting companion, a small app of its own (ML Kit's licence needs that).
    Its screen downloads ML Kit's handwriting models; until they are in, its icon is on the
    launcher (the alias below), and it hides itself once they are. It also fetches them by itself
    the first time Lychee binds RecognitionService (Lychee's pad uses its own engine until they
    are in). Lychee opens the screen from Settings > Add-ons. Only apps signed with Lychee's key
    may bind the service (the signature permission, which Lychee declares too, so it holds it
    whichever app is installed first).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ML Kit downloads its handwriting models (only the companion goes online, never Lychee) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <permission
        android:name="app.lychee.permission.HANDWRITING"
        android:protectionLevel="signature" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".SetupActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="app.lychee.hwgoogle.SETUP" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- on the launcher until the models are in (SetupActivity then switches it off) -->
        <activity-alias
            android:name=".Launcher"
            android:targetActivity=".SetupActivity"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".RecognitionService"
            android:exported="true"
            android:permission="app.lychee.permission.HANDWRITING" />
    </application>
</manifest>
