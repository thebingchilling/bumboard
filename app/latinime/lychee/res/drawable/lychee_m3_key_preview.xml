<?xml version="1.0" encoding="utf-8"?>
<!--
    The bubble above a pressed key: exactly the long-press popup's panel with one key in it
    (lychee_m3_popup_panel: the key colour, the same corners and padding, its shadow from the
    view's elevation, no drawn shadow strip), so a single letter and several letters look alike.
    KeyPreviewChoreographer widens it to the key; its height is lychee_key_preview_height and
    LatinIME places it from keyPreviewOffset. Its size is only the smallest it can be: letters are
    never squeezed to fit it (KeyPreviewView).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="?attr/lycheeColorKey" />
    <corners android:radius="14dp" />
    <size android:width="52dp" android:height="60dp" />
    <padding android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp" />
</shape>
