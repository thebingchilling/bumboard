<?xml version="1.0" encoding="utf-8"?>
<!-- A key inside the long-press popup: while selected, a rounded square in the accent colour,
     the same shape as the key press bubble (the popup keeps its aspect ratio). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/lycheeColorAccent" />
            <corners android:radius="12dp" />
            <size android:width="40dp" android:height="48dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="12dp" />
            <size android:width="40dp" android:height="48dp" />
        </shape>
    </item>
</selector>
