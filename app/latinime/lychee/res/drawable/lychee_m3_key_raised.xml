<?xml version="1.0" encoding="utf-8"?>
<!-- Lychee Material 3 keys: a soft layered shadow (level-1 elevation) under each key. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_active="true" android:state_pressed="true"><layer-list><item android:top="1dp" android:bottom="0.5dp"><shape android:shape="rectangle"><solid android:color="?attr/lycheeColorAccentPressed" /><corners android:radius="8dp" /></shape></item></layer-list></item>
    <item android:state_active="true"><layer-list><item android:top="2dp" android:left="0.5dp" android:right="0.5dp"><shape android:shape="rectangle"><solid android:color="@color/lychee_m3_shadow_ambient" /><corners android:radius="8dp" /></shape></item><item android:top="1dp" android:bottom="0.5dp" android:left="0.25dp" android:right="0.25dp"><shape android:shape="rectangle"><solid android:color="@color/lychee_m3_shadow_soft" /><corners android:radius="8dp" /></shape></item><item android:top="0.5dp" android:bottom="1dp"><shape android:shape="rectangle"><solid android:color="@color/lychee_m3_shadow" /><corners android:radius="8dp" /></shape></item><item android:bottom="1.5dp"><shape android:shape="rectangle"><solid android:color="?attr/lycheeColorAccent" /><corners android:radius="8dp" /></shape></item></layer-list></item>
    <item android:state_checkable="true" android:state_checked="true" android:state_pressed="true"><layer-list><item android:top="1dp" android:bottom="0.5dp"><shape android:shape="rectangle"><solid android:color="@color/lychee_m3_primary_container_pressed" /><corners android:radius="8dp" /></shape></item></layer-list></item>
    <item android:state_checkable="true" android:state_pressed="true"><layer-list><item android:top="1dp" android:bottom="0.5dp"><shape android:shape="rectangle"><solid android:color="?attr/lycheeColorFunctionalPressed" /><corners android:radius="8dp" /></shape></item></layer-list></item>
    <item android:state_checkable="true" android:state_checked="true"><layer-list><item android:top="2dp" android:left="0.5dp" android:right="0.5dp"><shape android:shape="rectangle"><solid android:color="@color/lychee_m3_shadow_ambient" /><corners android:radius="8dp" /></shape></item><item android:top="1dp" android:bottom="0.5dp" android:left="0.25dp" android:right="0.25dp"><shape android:shape="rectangle"><solid android:color="@color/lychee_m3_shadow_soft" /><corners android:radius="8dp" /></shape></item><item android:top="0.5dp" android:bottom="1dp"><shape android:shape="rectangle"><solid android:color="@color/lychee_m3_shadow" /><corners android:radius="8dp" /></shape></item><item android:bottom="1.5dp"><shape android:shape="rectangle"><solid android:color="@color/lychee_m3_primary_container" /><corners android:radius="8dp" /></shape></item></layer-list></item>
    <item android:state_checkable="true"><layer-list><item android:top="2dp" android:left="0.5dp" android:right="0.5dp"><shape android:shape="rectangle"><solid android:color="@color/lychee_m3_shadow_ambient" /><corners android:radius="8dp" /></shape></item><item android:top="1dp" android:bottom="0.5dp" android:left="0.25dp" android:right="0.25dp"><shape android:shape="rectangle"><solid android:color="@color/lychee_m3_shadow_soft" /><corners android:radius="8dp" /></shape></item><item android:top="0.5dp" android:bottom="1dp"><shape android:shape="rectangle"><solid android:color="@color/lychee_m3_shadow" /><corners android:radius="8dp" /></shape></item><item android:bottom="1.5dp"><shape android:shape="rectangle"><solid android:color="?attr/lycheeColorFunctional" /><corners android:radius="8dp" /></shape></item></layer-list></item>
    <item android:state_empty="true" android:state_pressed="true"><shape android:shape="rectangle"><solid android:color="?attr/lycheeColorKeyPressed" /><corners android:radius="8dp" /></shape></item>
    <item android:state_empty="true" android:drawable="@android:color/transparent" />
    <item android:state_pressed="true"><layer-list><item android:top="1dp" android:bottom="0.5dp"><shape android:shape="rectangle"><solid android:color="?attr/lycheeColorKeyPressed" /><corners android:radius="8dp" /></shape></item></layer-list></item>
    <item><layer-list><item android:top="2dp" android:left="0.5dp" android:right="0.5dp"><shape android:shape="rectangle"><solid android:color="@color/lychee_m3_shadow_ambient" /><corners android:radius="8dp" /></shape></item><item android:top="1dp" android:bottom="0.5dp" android:left="0.25dp" android:right="0.25dp"><shape android:shape="rectangle"><solid android:color="@color/lychee_m3_shadow_soft" /><corners android:radius="8dp" /></shape></item><item android:top="0.5dp" android:bottom="1dp"><shape android:shape="rectangle"><solid android:color="@color/lychee_m3_shadow" /><corners android:radius="8dp" /></shape></item><item android:bottom="1.5dp"><shape android:shape="rectangle"><solid android:color="?attr/lycheeColorKey" /><corners android:radius="8dp" /></shape></item></layer-list></item>
</selector>
