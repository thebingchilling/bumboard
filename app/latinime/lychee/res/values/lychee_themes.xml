<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme for the Compose settings; colours come from LycheeTheme. -->
    <style name="Theme.Lychee" parent="@android:style/Theme.Material.Light.NoActionBar" />
    <!-- The install dialog shown over whatever opened a pack (the browser). -->
    <style name="Theme.Lychee.Translucent" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
    <!-- LYCHEE: pop-ups over the keys grow in and shrink away (res/anim/lychee_pop_*) -->
    <style name="LycheePopupAnimation">
        <item name="android:windowEnterAnimation">@anim/lychee_pop_in</item>
        <item name="android:windowExitAnimation">@anim/lychee_pop_out</item>
    </style>
</resources>
